      "batch": 4
    },
    "auto-146b31d0a8b7": {
      "text": "آغوش گرم و پرمهر خانواده با دستپخت عالی",
      "sha256": "12b8f17485e076cc33da1a869f0d8e972db8bd0d894a479fe4320484f296036c",
      "batch": 4
    },
    "auto-4f3909faac27": {
      "text": "آفتاب درخشان، روزهای گرم و رسیدن میوه‌ها",
